APP_BASE_URL=http://127.0.0.1:8000
# Quad frontend (frontend/): alert emails link to FRONTEND_BASE_URL/events/<id>,
# and CORS_ORIGINS lists the browser origins allowed to call the API (comma-separated).
FRONTEND_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DATABASE_PATH=data/club_alerts.db
APP_MODE=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SOURCE_INGEST_TOKEN=change-me
MARITIME_FEED_URL=http://127.0.0.1:8000/demo/maritime-feed
MARITIME_SOURCE_ID=src-demo-feed
MARITIME_FEED_FORMAT=json
MARITIME_LOOKAHEAD_DAYS=60
MARITIME_PRIVATE_BACKEND_HOST=
# Optional multi-source manifest; overrides the single-feed settings above.
MARITIME_SOURCES_FILE=
# Only enable after the persistent Instagram reader has a verified owner login.
MARITIME_INSTAGRAM_ENABLED=false
MARITIME_COMPUTERS_KEY=
MARITIME_SITE_STATE=data/club-sites-state.json
MARITIME_INSTAGRAM_STATE=data/instagram-monitor-state.json
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
WORKFLOW_API_TOKEN=change-me
REVIEWER_TOKEN=change-me
REVIEW_ENRICHMENT_TOKEN=
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=club_alerts
# Personal access token (Settings -> Developer -> Access tokens). Used only by scripts/dbx_worker.py.
DATABRICKS_TOKEN=
